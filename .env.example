# Copy to .env (git-ignored) or export in your shell. Django does not load .env itself.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Defaults to local/db.sqlite3 inside the project when unset.
# DJANGO_DB_PATH=/absolute/path/to/db.sqlite3

# Optional locally: where backups are written (default local/backups). Production values are set by the deployment.
# DJANGO_BACKUP_DIR=/absolute/path/to/backups
# Production uses DJANGO_SETTINGS_MODULE=config.settings_prod, which requires DJANGO_SECRET_KEY, DJANGO_ALLOWED_HOSTS,
# DJANGO_CSRF_TRUSTED_ORIGINS, DJANGO_DB_PATH, DJANGO_UPLOAD_DIR and DJANGO_BACKUP_DIR (see docs/deployment.md).
