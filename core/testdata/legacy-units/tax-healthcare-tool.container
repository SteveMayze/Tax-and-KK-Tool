# Managed by Ansible (infra/deploy.yaml). Do not edit by hand: changes are overwritten on the next deploy.
# A ROOTLESS Quadlet file: it lives in the service user's ~/.config/containers/systemd/ and is run by that user's
# systemd (systemctl --user). Quadlet adds the user-level "wait for network" dependency by itself.
[Unit]
Description=Tax and Healthcare Tool web app (rootless Podman Quadlet)

[Container]
Image=localhost/tax-healthcare-tool:current
ContainerName=tax-healthcare-tool-web
# Published on the server's loopback only (listen_address), for the health probes; the LAN cannot reach it. The gateway
# reaches the app by name on the gateway network instead (see Network= below).
PublishPort=127.0.0.1:8889:8000
# Also joins the gateway network (created by the separate gateway repository), so the reverse proxy reaches this container by
# name (tax-healthcare-tool-web:8000, the port INSIDE the container). Quadlet makes this unit wait for gateway.network.
Network=gateway.network
Volume=/home/homeapps/tax-healthcare-tool/data:/data
Volume=/home/homeapps/tax-healthcare-tool/uploads:/uploads
Volume=/home/homeapps/tax-healthcare-tool/backups:/backups
# The host service user appears in the container as the app user (see container_userns in group_vars).
UserNS=keep-id:uid=10001,gid=10001
User=10001
Group=10001
# SECRET_KEY lives only in this 0600 file owned by the service user, never in this unit file.
EnvironmentFile=/home/homeapps/tax-healthcare-tool/config/env
Environment=DJANGO_SETTINGS_MODULE=config.settings_prod
Environment=DJANGO_DB_PATH=/data/db.sqlite3
Environment=DJANGO_UPLOAD_DIR=/uploads
Environment=DJANGO_BACKUP_DIR=/backups
Environment=DJANGO_ALLOWED_HOSTS=host.example.invalid,localhost,127.0.0.1
Environment=DJANGO_CSRF_TRUSTED_ORIGINS=https://host.example.invalid
Environment=DJANGO_HTTPS=1
Environment=DJANGO_URL_PREFIX=/tax-healthcare
Environment=DJANGO_BEHIND_TLS_PROXY=1
Environment=DJANGO_HSTS_SECONDS=0
ReadOnly=true
Tmpfs=/tmp
NoNewPrivileges=true
DropCapability=ALL
PodmanArgs=--memory=512m --pids-limit=256
# A script, not an inline command: Quadlet re-quotes inline commands and breaks them.
HealthCmd=python /app/healthcheck.py
HealthInterval=30s
HealthTimeout=5s
HealthRetries=3
HealthStartPeriod=20s
HealthOnFailure=restart

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=180

[Install]
# default.target is what a user's systemd starts at boot (with linger) and at login.
WantedBy=default.target
