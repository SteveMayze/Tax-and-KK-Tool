# Managed by Ansible (infra/deploy.yaml). Do not edit by hand: changes are overwritten on the next deploy.
# A ROOTLESS Quadlet file: it lives in the service user's ~/.config/containers/systemd/ and is run by that user's
# systemd (systemctl --user). Quadlet adds the user-level "wait for network" dependency by itself.
[Unit]
Description=Tax and Healthcare Tool web app (rootless Podman Quadlet)

[Container]
Image={{ image_repo }}:current
ContainerName={{ container_name }}
# Reached directly over plain HTTP on the LAN (owner decision). Narrow with listen_address in group_vars.
PublishPort={{ listen_address }}:{{ app_port }}:8000
Volume={{ data_root }}/data:/data
Volume={{ data_root }}/uploads:/uploads
Volume={{ data_root }}/backups:/backups
# The host service user appears in the container as the app user (see container_userns in group_vars).
UserNS={{ container_userns }}
User={{ app_uid }}
Group={{ app_uid }}
# SECRET_KEY lives only in this 0600 file owned by the service user, never in this unit file.
EnvironmentFile={{ etc_dir }}/env
Environment=DJANGO_SETTINGS_MODULE=config.settings_prod
Environment=DJANGO_DB_PATH=/data/db.sqlite3
Environment=DJANGO_UPLOAD_DIR=/uploads
Environment=DJANGO_BACKUP_DIR=/backups
Environment=DJANGO_ALLOWED_HOSTS={{ allowed_hosts }}
Environment=DJANGO_CSRF_TRUSTED_ORIGINS={{ csrf_trusted_origins }}
Environment=DJANGO_HTTPS={{ '1' if use_https else '0' }}
Environment=DJANGO_URL_PREFIX={{ url_prefix }}
Environment=DJANGO_BEHIND_TLS_PROXY={{ '1' if behind_tls_proxy else '0' }}
Environment=DJANGO_HSTS_SECONDS={{ hsts_seconds }}
ReadOnly=true
Tmpfs=/tmp
NoNewPrivileges=true
DropCapability=ALL
PodmanArgs=--memory={{ memory_limit }} --pids-limit=256
# A script, not an inline command: Quadlet re-quotes inline commands and breaks them.
HealthCmd=python /app/healthcheck.py
HealthInterval=30s
HealthTimeout=5s
HealthRetries=3
HealthStartPeriod=20s
HealthOnFailure=restart

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=180

[Install]
# default.target is what a user's systemd starts at boot (with linger) and at login.
WantedBy=default.target
