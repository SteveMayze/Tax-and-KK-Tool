# Managed by Ansible (infra/deploy.yaml). Do not edit by hand: changes are overwritten on the next deploy.
# A ROOTLESS Quadlet file: it lives in the service user's ~/.config/containers/systemd/ and is run by that user's
# systemd (systemctl --user). Quadlet adds the user-level "wait for network" dependency by itself.
[Unit]
Description=Tax and Healthcare Tool web app (rootless Podman Quadlet)
{% if use_postgres | bool %}
# The platform's shared PostgreSQL (ADR 0035). Wants/After, not Requires: a restart of PostgreSQL does not restart the
# app; Django reconnects by itself (CONN_HEALTH_CHECKS).
Wants={{ db_unit }}
After={{ db_unit }}
{% endif %}
{% if use_u01 | bool %}
# No limit on start attempts while the disk is missing (see the guard in [Service]). systemd reads this key ONLY in
# [Unit]: in [Service] it logs "Unknown key" and ignores it (seen with systemd 257 on the server, ADR 0035).
StartLimitIntervalSec=0
{% endif %}

[Container]
Image={{ image_repo }}:current
ContainerName={{ container_name }}
# Published on the server's loopback only (listen_address), for the health probes; the LAN cannot reach it. The gateway
# reaches the app by name on the gateway network instead (see Network= below).
PublishPort={{ listen_address }}:{{ app_port }}:8000
# Also joins the gateway network (created by the separate gateway repository), so the reverse proxy reaches this container by
# name ({{ container_name }}:8000, the port INSIDE the container). Quadlet makes this unit wait for gateway.network.
Network={{ gateway_network }}
{% if use_postgres | bool %}
# The platform's database network: only containers on it reach PostgreSQL (host {{ db_host }}, port {{ db_port }});
# the database port is not published on the server.
Network={{ db_network_file }}
{% endif %}
{% if use_u01 | bool %}
# On the removable disk {{ mount_guard_path }} (ADR 0035); the secret env file below stays on the eMMC.
{% endif %}
Volume={{ data_root }}/data:/data
Volume={{ data_root }}/uploads:/uploads
Volume={{ data_root }}/backups:/backups
# The host service user appears in the container as the app user (see container_userns in group_vars).
UserNS={{ container_userns }}
User={{ app_uid }}
Group={{ app_uid }}
# SECRET_KEY lives only in this 0600 file owned by the service user, never in this unit file.
EnvironmentFile={{ etc_dir }}/env
Environment=DJANGO_SETTINGS_MODULE=config.settings_prod
{% if use_postgres | bool %}
# The password comes from the platform's Podman secret, as an environment variable inside the container only.
Secret={{ db_secret_name }},type=env,target=DJANGO_DB_PASSWORD
Environment=DJANGO_DB_HOST={{ db_host }}
Environment=DJANGO_DB_PORT={{ db_port }}
Environment=DJANGO_DB_NAME={{ db_name }}
Environment=DJANGO_DB_USER={{ db_user }}
{% else %}
Environment=DJANGO_DB_PATH=/data/db.sqlite3
{% endif %}
Environment=DJANGO_UPLOAD_DIR=/uploads
Environment=DJANGO_BACKUP_DIR=/backups
Environment=DJANGO_ALLOWED_HOSTS={{ allowed_hosts }}
Environment=DJANGO_CSRF_TRUSTED_ORIGINS={{ csrf_trusted_origins }}
Environment=DJANGO_HTTPS={{ '1' if use_https else '0' }}
Environment=DJANGO_URL_PREFIX={{ url_prefix }}
Environment=DJANGO_BEHIND_TLS_PROXY={{ '1' if behind_tls_proxy else '0' }}
Environment=DJANGO_HSTS_SECONDS={{ hsts_seconds }}
ReadOnly=true
Tmpfs=/tmp
NoNewPrivileges=true
DropCapability=ALL
PodmanArgs=--memory={{ memory_limit }} --pids-limit=256
# A script, not an inline command: Quadlet re-quotes inline commands and breaks them.
HealthCmd=python /app/healthcheck.py
HealthInterval=30s
HealthTimeout=5s
HealthRetries=3
HealthStartPeriod=20s
HealthOnFailure=restart

[Service]
{% if use_u01 | bool %}
# The guard: never start (and so never write data into the empty mount point) while {{ mount_guard_path }} is not a real
# mount point. A failed start is retried every 10 s, without a limit, until the disk is there. systemd's mount dependency only
# orders a start in a user unit and never blocks one, so it is not used (proven on the server, gateway ADR 0006).
ExecStartPre=/usr/bin/mountpoint -q {{ mount_guard_path }}
Restart=on-failure
RestartSec=10
{% else %}
Restart=always
RestartSec=5
{% endif %}
TimeoutStartSec=180

[Install]
# default.target is what a user's systemd starts at boot (with linger) and at login.
WantedBy=default.target
